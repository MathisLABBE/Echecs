<UserControl x:Class="Echecs.Controls.Case"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Echecs.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:Case, IsDesignTimeCreatable=True}"
             d:DesignHeight="50"
             d:DesignWidth="50">

    <Border Background="{Binding Couleur, ElementName=Root}">
        <ContentControl Content="{Binding Piece, ElementName=Root}" />
    </Border>

</UserControl>