<UserControl x:Class="Echecs.Controls.Plateau"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Echecs.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:Plateau, IsDesignTimeCreatable=True}"
             d:DesignHeight="600"
             d:DesignWidth="600">

    <Grid>
        <Grid x:Name="GrillePlateau" />

        <Canvas
            Panel.ZIndex="10"
            Visibility="Collapsed"
            x:Name="CalquePromotion">

            <Border
                Background="White"
                BorderBrush="#999"
                BorderThickness="1"
                CornerRadius="3"
                Padding="4"
                x:Name="MenuPromotion" />
        </Canvas>
    </Grid>
</UserControl>
