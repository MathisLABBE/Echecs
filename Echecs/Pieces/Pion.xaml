<local:Piece x:Class="Echecs.Pieces.Pion"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Echecs.Pieces"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:Pion, IsDesignTimeCreatable=True}"
             d:DesignHeight="50"
             d:DesignWidth="50">

    <Grid MouseLeftButtonDown="Piece_MouseLeftButtonDown">
        <Image
            Margin="5"
            Source="{Binding SourceImage, ElementName=Root}"
            Stretch="Uniform" />
    </Grid>
</local:Piece>
